HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Development uses a private local outbox under server/data/outbox (never served publicly).
# Production MUST use smtp, HTTPS, a strong APP_SECRET, and persistent storage.
MAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Fill locally, run npm run owner:create, then remove OWNER_PASSWORD from this file.
OWNER_EMAIL=
OWNER_PASSWORD=
